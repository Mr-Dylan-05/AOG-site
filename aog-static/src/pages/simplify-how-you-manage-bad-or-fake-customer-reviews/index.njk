<div class="fl-module fl-module-fl-post-info fl-node-5d9ac83264541 fl-animation fl-fade-down" data-node="5d9ac83264541" data-animation-delay="0.0" data-animation-duration="1">
	<div class="fl-module-content fl-node-content">
		<span class="fl-post-info-date">May 20, 2020</span><span class="fl-post-info-sep">/</span><span class="fl-post-info-author">fligno_dev</span><span class="fl-post-info-sep">/</span><span class="fl-post-info-comments"><a href="/simplify-how-you-manage-bad-or-fake-customer-reviews/#respond" tabindex="-1" aria-hidden="true">No Comments</a></span>	</div>
