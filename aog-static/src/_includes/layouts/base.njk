<!doctype html>
<html lang="en-AU">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title %}{{ title }}{% else %}{{ site.name }}{% endif %}</title>
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {# Empty/placeholder pages set `noindex: true` so thin content stays out of
     search. Such pages are also excluded from sitemap.xml — listing a page you
     have asked search engines not to index is a contradictory signal. #}
  {% if noindex %}
  <meta name="robots" content="noindex, follow">
  {% else %}
  {# Lifts Google's default limits on how much of the page may be shown.
     max-snippet:-1 allows an unlimited-length text snippet, max-image-preview:large
     permits a full-size image, max-video-preview:-1 an unlimited video preview.
     These govern eligibility for rich results and for being quoted in AI
     Overviews — without them Google truncates to a conservative default. #}
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1">
  {% endif %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">

  <!-- Open Graph / social -->
  {# og:image and twitter:image must be absolute — relative paths are ignored by
     every scraper, so `ogImage` is prefixed with site.url when it starts with /. #}
  {% set ogImageSrc = ogImage or site.defaultOgImage %}
  {% set ogImageAbs = (site.url ~ ogImageSrc) if (ogImageSrc and ogImageSrc[0] == "/") else ogImageSrc %}
  {% set pageTitle = title if title else site.name %}
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="en_AU">
  <meta property="og:title" content="{{ pageTitle }}">
  {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {% if ogImageAbs %}<meta property="og:image" content="{{ ogImageAbs }}">{% endif %}

  <meta name="twitter:card" content="{{ 'summary_large_image' if ogImageAbs else 'summary' }}">
  <meta name="twitter:title" content="{{ pageTitle }}">
  {% if description %}<meta name="twitter:description" content="{{ description }}">{% endif %}
  {% if ogImageAbs %}<meta name="twitter:image" content="{{ ogImageAbs }}">{% endif %}

  {# Discoverable feed for the resource library — how aggregators and some
     crawlers learn the site is an actively updated publication. #}
  <link rel="alternate" type="application/rss+xml" title="Ad On Group — AI resources" href="{{ site.url }}/feed.xml">

  <link rel="stylesheet" href="/assets/css/site.css">

  {# --- FUSE POINT: per-page <style>/head from the designed page goes here --- #}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body class="{{ bodyClass or '' }}">

  {% include "partials/header.njk" %}

  <main id="main">
    {# --- FUSE POINT: the designed page body is injected here --- #}
    {{ content | safe }}
  </main>

  {% include "partials/footer.njk" %}

  {# --- Global 3rd-party scripts (wired up in the FINAL step, toggled in _data/site.json) --- #}
  {% if site.thirdParty.googleAnalytics %}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.thirdParty.googleAnalytics }}"></script>
  <script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config','{{ site.thirdParty.googleAnalytics }}');</script>
  {% endif %}
  {% if site.thirdParty.tawkChat and site.thirdParty.tawkSrc %}
  <script async src="{{ site.thirdParty.tawkSrc }}" crossorigin="*"></script>
  {% endif %}

  {# --- FUSE POINT: per-page scripts from the designed page go here --- #}
  {% if extraScripts %}{{ extraScripts | safe }}{% endif %}
</body>
</html>
