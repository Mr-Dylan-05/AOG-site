---
layout: layouts/base.njk
bodyClass: "ind-page"
---
{#
  Layout for the industry pages — /ai-training-<industry>/.

  These are funnel landing pages, and the first version of them was not. It had
  no images where the converting campaign page has fifty, led with "40+
  businesses trained" — a number a competitor founded last year can rival — and
  volunteered its own limitations in the body copy. Confident is not the same as
  dishonest: nothing here overstates, but nothing here argues the other side's
  case either.

  Structure, in the order a cold visitor needs it:
    hero + proof   who this is for, and why this company
    pains          the reader recognising their own week
    use cases      the specific work, sector by sector
    outcome        what is different on day 91 — the spine of the pitch
    reviews        people in their position saying it worked
    authority      the sector's real objection, answered from strength
    next step      exactly what happens when they click
    session/local/faq/cross-links

  Front matter each page supplies:
    title, description, permalink, industry, h1, eyebrow, lede, clients,
    painsHeading, pains, useCasesHeading, useCasesLede, useCases,
    outcomeHeading, outcomeLede, outcomes, concern, nextStep,
    faq, reading, localAngle, closer
#}
<main class="ind">

  <section>
    <p class="ind-eyebrow">{{ eyebrow or "AI training" }}</p>
    <h1>{{ h1 }}</h1>
    <p class="ind-lede">{{ lede | safe }}</p>
    <div class="ind-actions">
      {# The audit first. It is the low-friction step for cold traffic, it is
         already built, and asking for a call first loses the people who are not
         ready to talk to anyone — which on these pages is most of them. #}
      <a class="ind-cta" href="/ai-quiz/">Get your free AI audit</a>
      <a class="ind-cta-alt" href="/ai-enquiry/">Or book a time to talk</a>
    </div>
    <p class="ind-trust">
      <b>Trusted by over {{ proof.clientCount }} Australian businesses.</b>
      Australian-owned since {{ proof.since }}, rated {{ proof.rating }} from
      {{ proof.reviewCount }} Google reviews, and delivered by Claude Certified Associates.
    </p>
    <div class="ind-logos" aria-label="Businesses that work with Ad On Group">
      {% for c in proof.clients %}
      <img src="{{ c.src }}" alt="{{ c.name }}" loading="lazy" width="120" height="40">
      {% endfor %}
    </div>
  </section>

  {% if clients %}
  <section>
    <h2>We already work in this sector</h2>
    <p>{{ clients | safe }}</p>
  </section>
  {% endif %}

  {% if pains and pains.length %}
  <section>
    <h2>{{ painsHeading }}</h2>
    <ul class="ind-list">
      {% for p in pains %}<li>{{ p | safe }}</li>{% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if useCases and useCases.length %}
  <section>
    <h2>{{ useCasesHeading or "What your team would actually use it for" }}</h2>
    {% if useCasesLede %}<p>{{ useCasesLede | safe }}</p>{% endif %}
    <div class="ind-grid">
      {% for u in useCases %}
      <article class="ind-card">
        <h3>{{ u.title }}</h3>
        <p>{{ u.body | safe }}</p>
      </article>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  {# The outcome. Without this the page is a spec sheet: "24 modules over three
     months" describes what you buy, not what changes. #}
  {% if outcomes and outcomes.length %}
  <section>
    <h2>{{ outcomeHeading or "Where your team is after three months" }}</h2>
    {% if outcomeLede %}<p>{{ outcomeLede | safe }}</p>{% endif %}
    <ol class="ind-steps">
      {% for o in outcomes %}
      <li>
        <span class="ind-step-n">{{ loop.index }}</span>
        <div><h3>{{ o.title }}</h3><p>{{ o.body | safe }}</p></div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  {% if proof.aiReviews.length %}
  <section>
    <h2>What people say after the program</h2>
    <div class="ind-reviews">
      {# slice() in Nunjucks splits into N chunks rather than taking N items,
         which quietly rendered two reviews instead of three. #}
      {% for r in proof.aiReviews %}{% if loop.index <= 3 %}
      <figure class="ind-review">
        <div class="ind-stars" aria-label="{{ r.rating }} out of 5">★★★★★</div>
        <blockquote>{{ r.text }}</blockquote>
        <figcaption>{{ r.name }}</figcaption>
      </figure>
      {% endif %}{% endfor %}
    </div>
    <p class="ind-trust">Rated {{ proof.rating }} from {{ proof.reviewCount }} Google reviews.</p>
  </section>
  {% endif %}

  {% if concern %}
  <section>
    <div class="ind-note">
      <h2>{{ concern.heading }}</h2>
      {{ concern.body | safe }}
    </div>
  </section>
  {% endif %}

  <section>
    <h2>How the training works</h2>
    <p>
      Three months, 24 modules, around two hours a week, self-paced so it fits around
      {{ industry }} work rather than pulling anyone off the job for a day. It runs in three
      stages: getting fluent with the tools, automating the tasks that repeat, then building
      AI agents that handle a slice of a job end to end.
    </p>
    <p>
      What we teach is tool-agnostic. Your team learns the thinking, then applies it in
      ChatGPT, Copilot, Gemini or Claude — so the skills survive whichever tool you
      standardise on next year.
    </p>
  </section>

  {# Ongoing support and community, with images. This is the single strongest
     answer to a one-day workshop — a workshop ends — so it gets its own section
     rather than a clause, and it is where most of the page's imagery lives. #}
  <section>
    <h2>{{ supportHeading or "The part that doesn't stop when the course does" }}</h2>
    <p>
      {{ supportLede | safe if supportLede else "Every program includes it. This is the
      difference between a team that had AI training once and a team that keeps getting
      better at it while the tools keep changing." }}
    </p>
    <div class="ind-features">
      {% for f in proof.support %}
      <figure class="ind-feature">
        <img src="{{ f.img }}" alt="{{ f.alt }}" loading="lazy" width="640" height="380">
        <figcaption>
          <h3>{{ f.title }}</h3>
          <p>{{ f.body | safe }}</p>
        </figcaption>
      </figure>
      {% endfor %}
    </div>
    <div class="ind-actions">
      <a class="ind-cta-alt" href="/ongoing-support/">More on ongoing support</a>
    </div>
  </section>

  {# What actually happens when they click. A CTA that does not say what the next
     step is asks for a leap of faith at exactly the wrong moment. #}
  <section>
    <div class="ind-note ind-next">
      <h2>{{ nextStepHeading or "What happens when you get in touch" }}</h2>
      <p>{{ nextStep | safe }}</p>
      <div class="ind-actions">
        <a class="ind-cta" href="/ai-quiz/">Get your free AI audit</a>
        <a class="ind-cta-alt" href="/ai-enquiry/">Book a time to talk</a>
      </div>
    </div>
  </section>

  {% for w in webinarSchedule.upcoming %}{% if w.industry == page.url %}
  <section>
    <h2>See how we teach it, first</h2>
    <p>
      <a href="{{ w.url }}">{{ w.title }}</a> — {{ w.pretty }}, {{ w.prettyTime }}. Free,
      online, 45 minutes, open to anyone. {{ w.blurb }}
    </p>
    <div class="ind-actions">
      <a class="ind-cta-alt" href="{{ w.url }}">Details and registration</a>
    </div>
  </section>
  {% endif %}{% endfor %}

  {# Industry × location. "AI training for accounting firms in Brisbane" is a
     question almost nobody has written a page for. `localAngle` is a real
     observation about this sector in these places, not a list of city names. #}
  <section>
    <h2>Where we work</h2>
    <p>
      We're on the Gold Coast, we work across South East Queensland and Northern NSW, and
      we have an office in Adelaide. The program runs online and self-paced, so your team
      gets the same thing wherever they are.
    </p>
    {% if localAngle %}<p>{{ localAngle | safe }}</p>{% endif %}
    <div class="ind-more">
      {% for l in locations.items %}
        {% if l.hasPage %}<a href="/ai-training-{{ l.slug }}/">{{ l.name }}</a>
        {% else %}<span class="ind-place">{{ l.name }}</span>{% endif %}
      {% endfor %}
    </div>
  </section>

  {% if faq and faq.length %}
  <section>
    <h2>Questions {{ industry }} teams ask</h2>
    {% for item in faq %}
    <details>
      <summary>{{ item.q }}</summary>
      <div><p>{{ item.a | safe }}</p></div>
    </details>
    {% endfor %}
  </section>
  {% endif %}

  {% if reading and reading.length %}
  <section>
    <h2>Worth reading first</h2>
    <div class="ind-more">
      {% for r in reading %}<a href="{{ r.url }}">{{ r.label }}</a>{% endfor %}
    </div>
  </section>
  {% endif %}

  <section>
    <h2>We train other sectors too</h2>
    <div class="ind-more">
      {% for i in industries.items %}{% if i.url != page.url %}
      <a href="{{ i.url }}">{{ i.label }}</a>
      {% endif %}{% endfor %}
    </div>
  </section>

  <section>
    <h2>{{ closerHeading or "Get your team started" }}</h2>
    <p>{{ closer | safe }}</p>
    <div class="ind-actions">
      <a class="ind-cta" href="/ai-quiz/">Get your free AI audit</a>
      <a class="ind-cta-alt" href="/ai-enquiry/">Book a time to talk</a>
    </div>
  </section>

</main>
