# ############################################################################
# NOT ACTIVE ON THE CURRENT HOST.
#
# The site is served by Vercel, which reads vercel.json and ignores .htaccess.
# This file only matters if the site moves to Apache/cPanel hosting.
#
# ==> Edit aog-static/vercel.json.
# ############################################################################

# Apache / cPanel config — only used if the site is uploaded to traditional
# hosting rather than a git-connected platform. Harmless (ignored) elsewhere.
#
# This replaces the old WordPress .htaccess entirely: there is no PHP front
# controller to route through any more, just files on disk.

# ----------------------------------------------------------------- redirects
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Images moved out of the WordPress library. Years of inbound links, Google
  # Image results and old social cards still point at the old paths.
  RewriteRule ^wp-content/uploads/(.*)$ /assets/media/$1 [R=301,L]
  RewriteRule ^wp-content/plugins/(.*)$ /assets/media/_plugins/$1 [R=301,L]

  # Retired WordPress endpoints — send them home rather than to a 404.
  RewriteRule ^wp-admin(/.*)?$ / [R=301,L]
  RewriteRule ^wp-login\.php$ / [R=301,L]
  RewriteRule ^xmlrpc\.php$ / [R=301,L]

  # WordPress archive URLs. These are not in the sitemap but WordPress serves
  # them with a 200, so they are indexed and may carry links. The static site
  # generates no archives, so without these they would 404 and lose that equity.
  RewriteRule ^category/.*$ /blog/ [R=301,L]
  RewriteRule ^tag/.*$ /blog/ [R=301,L]
  RewriteRule ^author/.*$ /blog/ [R=301,L]
  RewriteRule ^blog/page/.*$ /blog/ [R=301,L]
  RewriteRule ^20[0-9]{2}(/[0-9]{2})?/?$ /blog/ [R=301,L]

  # Injected spam URLs from the WordPress compromise, which Google has indexed.
  # 410 Gone (the [G] flag) rather than 404: it asserts permanent removal and is
  # actioned faster. Never redirect these home — that reads as a soft 404 and
  # ties the spam to the homepage.
  RewriteRule ^products(/.*)?$ - [G,L]



  # --- Consolidated pages (scripts/consolidate-pages.js) ---
  RewriteRule ^edm/?$ /ad-on-digital/ [R=301,L]
  RewriteRule ^google-ads/?$ /google-ads-management/ [R=301,L]
  RewriteRule ^ad-on-workforce/about/?$ /ad-on-workforce/ [R=301,L]
  RewriteRule ^ad-on-workforce/services/?$ /ad-on-workforce/ [R=301,L]
  RewriteRule ^faqs/aod-faqs/?$ /faqs/ [R=301,L]
  RewriteRule ^faqs/aoh-faqs/?$ /faqs/ [R=301,L]
  RewriteRule ^package/customer-service/?$ /customer-service/ [R=301,L]
  RewriteRule ^package/general-admin-staff/?$ /general-admin-staff/ [R=301,L]
  RewriteRule ^package/finance-admin-staff/?$ /finance-admin-staff/ [R=301,L]
  RewriteRule ^package/data-entry-collation-position/?$ /data-entry-collation/ [R=301,L]
  RewriteRule ^package/bespoke-repeatable-task-role/?$ /bespoke-repeatable-task-role/ [R=301,L]
  RewriteRule ^package/marketing-assistant/?$ /marketing-assistant/ [R=301,L]
  RewriteRule ^package/executive-personal-assistant/?$ /executive-personal-assistant/ [R=301,L]
  RewriteRule ^bpo-ai-program/?$ /bpo-program/ [R=301,L]
  RewriteRule ^ad-on-group/?$ / [R=301,L]
  # --- end consolidated pages ---


  # --- Post-launch sweep (Aug 2026) ---
  RewriteRule ^review-me/?$ /ad-on-digital/ [R=301,L]
  RewriteRule ^online-accelerator/?$ /ad-on-digital/ [R=301,L]
  RewriteRule ^home-2025-copy/?$ / [R=301,L]
  RewriteRule ^website-examples/?$ /ad-on-digital/ [R=301,L]

  # Serve /path/ from /path/index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ /$1/index.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ------------------------------------------------------------------- caching
<IfModule mod_expires.c>
  ExpiresActive On
  # Content-addressed by path; safe to cache hard.
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|mp4|woff2?)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>
  # HTML must stay fresh so content edits appear immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
  </FilesMatch>
</IfModule>

# ------------------------------------------------------------------ security
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
