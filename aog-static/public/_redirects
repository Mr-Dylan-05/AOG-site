# Host-level redirects (Netlify / Cloudflare Pages format).
# The static site keeps the same URLs as the old WordPress site, so most
# links carry over 1:1 with no redirect needed. Add old->new mappings here
# only when a URL actually changes during the content overhaul.
#
# Format:  /old-path   /new-path   301
#
# Example:
# /christmas-offer-2019/   /   301

# --- WordPress media ---------------------------------------------------------
# Images moved out of the WordPress library into /assets/media/. Page URLs are
# unchanged, but years of inbound links, Google Image results and old social
# cards still point at /wp-content/uploads/..., so keep those alive.
/wp-content/uploads/*   /assets/media/:splat            301
/wp-content/plugins/*   /assets/media/_plugins/:splat   301

# --- Retired WordPress endpoints ---------------------------------------------
# Nothing serves these any more; send them home rather than to a 404.
/wp-login.php           /   301
/wp-admin/*             /   301
/xmlrpc.php             /   301
